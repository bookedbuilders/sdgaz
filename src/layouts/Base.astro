---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Electrician Near You in Phoenix & Scottsdale | Same-Day Service | SDG Electric",
  description = "Need an electrician near you? SDG Electric serves North Phoenix, Scottsdale, and Paradise Valley with same-day repairs and 24/7 emergency service. Call now!",
  noindex = false,
} = Astro.props;

// Canonical: strip query strings so gclid/UTM variants collapse to one URL.
// Also strip the .html suffix from format:'file' builds — Vercel cleanUrls
// serves /page, so that's the canonical form.
const canonicalURL = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) — Google Ads AW-18374148612, SDG-owned.
         Base tag only: page views + remarketing. It does NOT record a
         conversion; that needs an event snippet with a conversion label.
         See DESIGN-SYSTEM.md, Third-party services. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18374148612"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18374148612');
    </script>
    <!-- ============================================================
      GOOGLE CALL FORWARDING (website call conversions) - DORMANT
      ============================================================
      Swaps the displayed phone number with a Google forwarding number
      for ad-click visitors so calls count as conversions
      (label Jh5pCLuD8uYcEISEvblE).

      TO ACTIVATE when Joe says "turn on the Google forwarding thing":
      replace this whole HTML comment with a real script tag:

        [script]
          gtag('config', 'AW-18374148612/Jh5pCLuD8uYcEISEvblE', {
            'phone_conversion_number': '(602) 905-5281'
          });
        [/script]

      ([script] = angle-bracket script tags; written square here because
      a literal closing script tag inside any comment breaks HTML parsing.
      It must be a separate script AFTER the base gtag config above.)

      CHECK 1 - NUMBER FORMAT: this site renders the phone as
      "602-905-5281" (dashes). Google only swaps numbers whose displayed
      text matches phone_conversion_number. If replacement does not fire
      in testing, change the value to '602-905-5281'.

      CHECK 2 - DOUBLE COUNTING: the click-to-call conversion above
      (crk9CK6J1-UcEISEvblE) tracks tel: taps; forwarding counts the
      same calls. After activating, set one of the two call actions to
      "Secondary" in Google Ads goals.
    ============================================================= -->

    <!-- Event snippet: "Click to call" conversion (AW-18374148612/crk9CK6J1-UcEISEvblE).
         Google's snippet, with two guards added: bail straight to the call if
         gtag is missing (ad blockers block googletagmanager.com), and time out
         after 800ms so a slow ping can never swallow the phone call. -->
    <script is:inline>
      function gtag_report_conversion(url) {
        var fired = false;
        var callback = function () {
          if (fired) return;
          fired = true;
          if (typeof(url) != 'undefined') {
            window.location = url;
          }
        };
        if (typeof gtag !== 'function') {
          callback();
          return false;
        }
        setTimeout(callback, 800);
        gtag('event', 'conversion', {
            'send_to': 'AW-18374148612/crk9CK6J1-UcEISEvblE',
            'value': 1.0,
            'currency': 'USD',
            'event_callback': callback
        });
        return false;
      }

      // Every tel: link on the site reports the conversion. Delegated, so links
      // added later are covered without touching this file.
      document.addEventListener('click', function (e) {
        var link = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (!link) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        gtag_report_conversion(link.getAttribute('href'));
      });
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Social share cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SDG Electric" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/assets/team.webp', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Favicon: SDG bolt mark, same zap shape used across the page -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Ad attribution: gclid/UTMs land on THIS page, but the booking survey is
         a cross-origin iframe with its own URL, so it cannot see them. GHL's own
         embed script reads window.top.location.search, which throws cross-origin
         and falls back to the iframe's own query string — so the params have to
         be appended to the iframe src. Stashed in sessionStorage so the click id
         survives / -> /book navigation. -->
    <script is:inline>
      (function () {
        var qs = window.location.search.slice(1);
        try {
          if (qs) sessionStorage.setItem('sdg_params', qs);
          else qs = sessionStorage.getItem('sdg_params') || '';
        } catch (e) { /* private mode: fall through with whatever this page has */ }
        window.__sdgParams = qs;
        window.__sdgSurveyUrl = function (base) {
          if (!base || !qs) return base;
          return base + (base.indexOf('?') > -1 ? '&' : '?') + qs;
        };
      })();
    </script>
    <!-- First-party analytics (~2KB, no cookies, no third-party domain).
         Batches events and ships them to /api/track (api/track.ts, same origin)
         via sendBeacon so nothing ever blocks a tap or navigation. Boots on
         DOMContentLoaded (trivial work, no LCP cost). Reads window.__sdgParams (set above) for
         UTM/gclid attribution. Event names follow GA4: page_view, scroll,
         section_view (dwell ms), click / book_click / call_click,
         booking_complete (thank-you view), user_engagement (visible ms).
         Viewed in the Sidehouse dashboard at /landing. -->
    <script is:inline>
      (function () {
        if (navigator.webdriver) return;
        var EP = '/api/track', q = [], t0 = Date.now(), tLast = t0, maxScroll = 0;
        var rnd = function () { return Math.random().toString(36).slice(2, 10) + Date.now().toString(36); };
        var sid, vid;
        try {
          sid = sessionStorage.getItem('sdg_sid'); if (!sid) { sid = rnd(); sessionStorage.setItem('sdg_sid', sid); }
          vid = localStorage.getItem('sdg_vid');   if (!vid) { vid = rnd(); localStorage.setItem('sdg_vid', vid); }
        } catch (e) { sid = sid || rnd(); vid = vid || ''; }

        // Internal traffic (GA4 "internal traffic" filter). ?internal=1 marks this
        // browser for good, ?internal=0 clears it; localhost is always internal.
        // The dashboard hides internal=1 unless it's in Test mode.
        var internal = location.hostname === 'localhost' ? 1 : 0;
        try {
          var im = location.search.match(/[?&]internal=([01])/);
          if (im) localStorage.setItem('sdg_internal', im[1]);
          if (localStorage.getItem('sdg_internal') === '1') internal = 1;
        } catch (e) {}

        var p = new URLSearchParams(window.__sdgParams || ''), gclid = !!p.get('gclid');
        var base = {
          sid: sid, vid: vid, path: location.pathname, internal: internal,
          src: p.get('utm_source') || (gclid ? 'google' : ''),
          med: p.get('utm_medium') || (gclid ? 'cpc' : ''),
          camp: p.get('utm_campaign') || '', gclid: gclid ? 1 : 0,
          dev: innerWidth < 768 ? 'mobile' : innerWidth < 1024 ? 'tablet' : 'desktop',
          frame: window.top !== window.self ? 1 : 0
        };

        function ev(t, o) {
          var e = { t: t, ts: new Date().toISOString(), ms: Date.now() - t0 };
          for (var k in o) e[k] = o[k];
          q.push(e); if (q.length >= 20) flush();
        }
        function flush() {
          if (!q.length) return;
          var body = JSON.stringify(Object.assign({ ev: q }, base)); q = [];
          try { if (navigator.sendBeacon && navigator.sendBeacon(EP, new Blob([body], { type: 'text/plain' }))) return; } catch (e) {}
          try { fetch(EP, { method: 'POST', body: body, keepalive: true, headers: { 'content-type': 'text/plain' } }).catch(function () {}); } catch (e) {}
        }

        // Sections: keyed by id, else slugified aria-label — every section has one.
        var secs = {}, curSec = '', curRatio = 0, keyOf = function (el) {
          return el.id || (el.getAttribute('aria-label') || el.tagName).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        };
        function finalize() {
          var now = Date.now();
          for (var k in secs) {
            var s = secs[k], total = s.total + (s.enter ? now - s.enter : 0);
            if (!s.seen) continue;
            ev('section_view', { sec: k, v: total, first: s.first });
            s.total = 0; if (s.enter) s.enter = now;
          }
        }

        function start() {
          ev('page_view', { ref: document.referrer.slice(0, 200), title: document.title.slice(0, 120), vw: innerWidth, vh: innerHeight });
          if (location.pathname === '/thank-you') ev('booking_complete', { label: 'GHL survey redirect' });

          if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
              var now = Date.now();
              entries.forEach(function (en) {
                var k = keyOf(en.target), s = secs[k] || (secs[k] = { total: 0, enter: 0, seen: false, first: 0 });
                if (en.isIntersecting) { if (!s.seen) { s.seen = true; s.first = now - t0; } s.enter = now; }
                else if (s.enter) { s.total += now - s.enter; s.enter = 0; }
                // Most-visible section = what a sticky-bar tap is really "about".
                if (en.isIntersecting && en.intersectionRatio >= curRatio) { curSec = k; curRatio = en.intersectionRatio; }
                else if (!en.isIntersecting && k === curSec) { curRatio = 0; }
              });
            }, { threshold: [0.25, 0.5, 0.75] });
            document.querySelectorAll('section, footer').forEach(function (el) { io.observe(el); });
          }

          // No throttle: the work is a few arithmetic ops, and rAF-based
          // throttling stalls in background tabs and can drop the final position.
          var marks = [25, 50, 75, 100];
          function onScroll() {
            var h = document.documentElement.scrollHeight - innerHeight;
            var pct = h > 0 ? Math.min(100, Math.round((scrollY / h) * 100)) : 100;
            if (pct > maxScroll) maxScroll = pct;
            while (marks.length && pct >= marks[0]) ev('scroll', { v: marks.shift() });
          }
          addEventListener('scroll', onScroll, { passive: true }); onScroll();

          document.addEventListener('click', function (e) {
            var el = e.target && e.target.closest ? e.target.closest('a, button, [data-track]') : null;
            if (!el) return;
            var href = el.getAttribute('href') || '', kind = 'click';
            if (/^tel:/i.test(href)) kind = 'call_click';
            else if (el.classList.contains('schedule-btn-rai') || href === '/book') kind = 'book_click';
            var label = el.getAttribute('data-track') || el.getAttribute('aria-label') || (el.textContent || '').replace(/\s+/g, ' ').trim();
            var wrap = el.closest('section, footer, dialog'), sticky = !!el.closest('#mobile-cta');
            ev(kind, {
              // Sticky bar has no section of its own: attribute to the section on screen, flag it.
              label: label.slice(0, 60), sec: wrap ? keyOf(wrap) : (sticky ? curSec : ''), bar: sticky ? 1 : 0, href: href.slice(0, 120),
              x: Math.round((e.clientX / innerWidth) * 100), y: Math.round((e.clientY / innerHeight) * 100)
            });
            if (kind !== 'click') flush();
          }, true);

          var left = false;
          function leave() {
            if (left) return; left = true;
            var now = Date.now();
            finalize();
            ev('user_engagement', { v: now - tLast, scroll: maxScroll }); tLast = now;
            flush();
          }
          addEventListener('pagehide', leave);
          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'hidden') leave(); else left = false;
          });
        }

        // DOMContentLoaded, not load: sections exist by then, and waiting for
        // every image would lose the page_view of anyone who bounces early.
        if (document.readyState !== 'loading') setTimeout(start, 0);
        else document.addEventListener('DOMContentLoaded', function () { setTimeout(start, 0); });
      })();
    </script>
    <!-- Preload LCP image (hero logo) before browser discovers it in HTML -->
    <link rel="preload" as="image" href="/assets/logo.png" fetchpriority="high" />
    <!-- Booking survey (GHL) is loaded on idle/intent — warm the connection early -->
    <link rel="preconnect" href="https://api.leadconnectorhq.com" crossorigin />
    <link rel="dns-prefetch" href="//api.leadconnectorhq.com" />
  </head>
  <body class="antialiased text-[#212121] overflow-x-hidden">

    <!-- SVG filter for logo white outline -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="logo-stroke">
          <feMorphology in="SourceAlpha" operator="dilate" radius="4" result="DILATED" />
          <feFlood flood-color="white" flood-opacity="1" result="WHITE" />
          <feComposite in="WHITE" in2="DILATED" operator="in" result="OUTLINE" />
          <feMerge>
            <feMergeNode in="OUTLINE" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
    </svg>
    <slot />
  </body>
</html>
