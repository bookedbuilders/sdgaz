---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Electrician in Phoenix | Fast, Safe Service | SDG Electric",
  description = "Reliable electrician in Phoenix, AZ. SDG Electric provides electrical repair, installation, and 24/7 emergency service you can trust. Call us!",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) — Google Ads AW-18374148612, SDG-owned.
         Base tag only: page views + remarketing. It does NOT record a
         conversion; that needs an event snippet with a conversion label.
         See DESIGN-SYSTEM.md, Third-party services. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18374148612"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18374148612');
    </script>

    <!-- Event snippet: "Click to call" conversion (AW-18374148612/crk9CK6J1-UcEISEvblE).
         Google's snippet, with two guards added: bail straight to the call if
         gtag is missing (ad blockers block googletagmanager.com), and time out
         after 800ms so a slow ping can never swallow the phone call. -->
    <script is:inline>
      function gtag_report_conversion(url) {
        var fired = false;
        var callback = function () {
          if (fired) return;
          fired = true;
          if (typeof(url) != 'undefined') {
            window.location = url;
          }
        };
        if (typeof gtag !== 'function') {
          callback();
          return false;
        }
        setTimeout(callback, 800);
        gtag('event', 'conversion', {
            'send_to': 'AW-18374148612/crk9CK6J1-UcEISEvblE',
            'value': 1.0,
            'currency': 'USD',
            'event_callback': callback
        });
        return false;
      }

      // Every tel: link on the site reports the conversion. Delegated, so links
      // added later are covered without touching this file.
      document.addEventListener('click', function (e) {
        var link = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (!link) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        gtag_report_conversion(link.getAttribute('href'));
      });
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Favicon: SDG bolt mark, same zap shape used across the page -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Ad attribution: gclid/UTMs land on THIS page, but the booking survey is
         a cross-origin iframe with its own URL, so it cannot see them. GHL's own
         embed script reads window.top.location.search, which throws cross-origin
         and falls back to the iframe's own query string — so the params have to
         be appended to the iframe src. Stashed in sessionStorage so the click id
         survives / -> /book navigation. -->
    <script is:inline>
      (function () {
        var qs = window.location.search.slice(1);
        try {
          if (qs) sessionStorage.setItem('sdg_params', qs);
          else qs = sessionStorage.getItem('sdg_params') || '';
        } catch (e) { /* private mode: fall through with whatever this page has */ }
        window.__sdgParams = qs;
        window.__sdgSurveyUrl = function (base) {
          if (!base || !qs) return base;
          return base + (base.indexOf('?') > -1 ? '&' : '?') + qs;
        };
      })();
    </script>
    <!-- Preload LCP image (hero logo) before browser discovers it in HTML -->
    <link rel="preload" as="image" href="/assets/logo.png" fetchpriority="high" />
    <!-- Booking survey (GHL) is loaded on idle/intent — warm the connection early -->
    <link rel="preconnect" href="https://api.leadconnectorhq.com" crossorigin />
    <link rel="dns-prefetch" href="//api.leadconnectorhq.com" />
  </head>
  <body class="antialiased text-[#212121] overflow-x-hidden">

    <!-- SVG filter for logo white outline -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="logo-stroke">
          <feMorphology in="SourceAlpha" operator="dilate" radius="4" result="DILATED" />
          <feFlood flood-color="white" flood-opacity="1" result="WHITE" />
          <feComposite in="WHITE" in2="DILATED" operator="in" result="OUTLINE" />
          <feMerge>
            <feMergeNode in="OUTLINE" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
    </svg>
    <slot />
  </body>
</html>
