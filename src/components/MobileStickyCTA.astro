---
const PHONE_NUMBER = "480-415-0660";
---

<div
  id="mobile-cta"
  class="lg:hidden fixed bottom-0 left-0 right-0 z-[60] bg-white border-t-[3px] border-black p-4 translate-y-full transition-transform duration-500"
  aria-hidden="true"
>
  <div class="flex w-full gap-4">
    <a
      href={`tel:${PHONE_NUMBER}`}
      aria-label="Call Now — bottom bar"
      class="flex-1 bg-white text-black py-4 flex items-center justify-center gap-2 font-black uppercase text-sm tracking-widest italic border-2 border-black shadow-[6px_6px_0px_0px_#D58C46] active:shadow-none active:translate-x-[2px] active:translate-y-[2px] transition-all"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="black" stroke="none"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.26 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.18 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      Call Now
    </a>
    <a
      id="schedule-btn-rai"
      href="https://form.recreateai.com/?rai_pak=57aa3ca2-4a06-4329-b414-f9695d418558"
      aria-label="Book Now — bottom bar"
      class="schedule-btn-rai flex-[1.2] bg-black text-white py-4 flex items-center justify-center gap-2 font-black uppercase text-sm tracking-widest italic border-2 border-black shadow-[6px_6px_0px_0px_#D58C46] active:shadow-none active:translate-x-[2px] active:translate-y-[2px] transition-all"
    >
      Schedule
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#D58C46" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById('mobile-cta')!;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      bar.classList.remove('translate-y-full');
      bar.setAttribute('aria-hidden', 'false');
    } else {
      bar.classList.add('translate-y-full');
      bar.setAttribute('aria-hidden', 'true');
    }
  }, { passive: true });
</script>
