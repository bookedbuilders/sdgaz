---
// Crew intro at first scroll: the trust photo does the talking.
// Photo shows the family crew, branded van, and the ROC number on the wrap.
---

<section class="bg-white pt-16 md:pt-24 pb-8 relative" aria-label="Meet the SDG Electric crew">
  <div class="max-w-7xl mx-auto px-6 md:px-12 grid lg:grid-cols-5 gap-10 lg:gap-16 items-stretch">

    <!-- Photo — first on every breakpoint -->
    <div class="lg:col-span-3 order-1 flex flex-col">
      <div class="relative group flex-1 min-h-[260px] shadow-[12px_12px_0px_0px_#D58C46] md:shadow-[24px_24px_0px_0px_#D58C46]">
        <img
          src="/assets/team.webp"
          alt="The SDG Electric crew and family in front of their branded Phoenix service van"
          width="1600"
          height="1199"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover border-2 border-black bg-white"
        />
        <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6 bg-black text-white px-4 py-3 sm:px-6 sm:py-4 font-black italic uppercase text-[10px] tracking-[0.3em] border border-white/20">
          THE SDG ELECTRIC CREW
        </div>
      </div>
    </div>

    <!-- Copy -->
    <div class="lg:col-span-2 order-2 flex flex-col justify-center space-y-5">
      <p class="text-accent font-black text-xs sm:text-sm uppercase tracking-[0.4em] italic">Always Local</p>
      <h2 class="text-4xl sm:text-5xl lg:text-[56px] font-black uppercase italic leading-[0.9] tracking-tighter">THE CREW YOUR <br />NEIGHBORS CALL.</h2>
      <p class="text-black/70 font-medium leading-relaxed text-lg sm:text-xl">
        Family-run, licensed, and local — the same faces on the wrap are the ones in your driveway.
      </p>
    </div>

  </div>
</section>
