---
interface Card {
  icon?: string;      // emoji string (dark/light variants)
  iconPath?: string;  // SVG path data (services variant)
  title: string;
  desc?: string;
  img?: string;       // hover background image (services variant)
}

interface Props {
  cards: Card[];
  variant?: 'services' | 'dark' | 'light';
  eyebrow?: string;
  headline?: string;   // HTML allowed
  subheadline?: string;
  sectionId?: string;
  sectionLabel?: string;
  padBottom?: boolean;
}

const {
  cards,
  variant = 'light',
  eyebrow,
  headline,
  subheadline,
  sectionId,
  sectionLabel,
  padBottom = true,
} = Astro.props;

const darkBg = variant === 'dark';
const gridCols =
  variant === 'services' ? 'grid-cols-2 lg:grid-cols-4' :
  variant === 'dark'     ? 'grid-cols-1 md:grid-cols-2' :
                           'grid-cols-1 md:grid-cols-3';
---

<section
  id={sectionId}
  class={`pt-24 md:pt-32 ${padBottom ? 'pb-24 md:pb-32' : ''} ${darkBg ? 'bg-black text-white' : 'bg-white text-black'}`}
  aria-label={sectionLabel}
>
  <div class="max-w-7xl mx-auto px-6 md:px-12">

    {(eyebrow || headline || subheadline) && (
      <div class="mb-16 md:mb-24">
        {eyebrow && (
          <p class="text-accent font-black text-xs sm:text-sm uppercase tracking-[0.4em] mb-4 italic">{eyebrow}</p>
        )}
        {headline && (
          <h2 class="text-5xl md:text-7xl lg:text-[72px] font-black italic tracking-tighter uppercase leading-[0.9] max-w-4xl" set:html={headline} />
        )}
        {subheadline && (
          <p class={`font-medium leading-relaxed max-w-2xl text-lg mt-6 ${darkBg ? 'text-white/60' : 'text-black/60'}`}>{subheadline}</p>
        )}
      </div>
    )}

    <div class={`grid ${gridCols} gap-6`}>

      {variant === 'services' && cards.map((card) => (
        <div class="group relative bg-white p-6 md:p-10 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,0.05)] hover:bg-black hover:text-white transition-all duration-300 cursor-pointer flex flex-col items-center text-center overflow-hidden">
          {card.img && (
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-40 transition-opacity duration-500 bg-cover bg-center scale-110 group-hover:scale-100"
              data-bg={card.img}
            ></div>
          )}
          <div class="relative z-10 text-accent mb-4 md:mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={card.iconPath} />
          </div>
          <h3 class="relative z-10 text-sm md:text-xl font-black uppercase italic tracking-tighter">{card.title}</h3>
        </div>
      ))}

      {variant === 'dark' && cards.map((card) => (
        <div class="bg-white/5 border border-white/10 border-l-4 border-l-accent p-8 hover:bg-white/10 transition-all">
          {card.icon && <div class="text-4xl mb-4">{card.icon}</div>}
          <h3 class="font-black text-xl uppercase italic tracking-tighter leading-tight mb-3">{card.title}</h3>
          {card.desc && <p class="text-white/60 font-medium leading-relaxed">{card.desc}</p>}
        </div>
      ))}

      {variant === 'light' && cards.map((card) => (
        <div class="border-2 border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-2 hover:translate-y-2 transition-all bg-white">
          {card.icon && <div class="text-4xl mb-4">{card.icon}</div>}
          <h3 class="font-black text-xl uppercase italic tracking-tighter leading-tight mb-3">{card.title}</h3>
          {card.desc && <p class="text-black/60 font-medium leading-relaxed">{card.desc}</p>}
        </div>
      ))}

    </div>

    <!-- Slot for any extra content below the grid (e.g. pricing callout) -->
    <slot />

  </div>
</section>

{variant === 'services' && (
  <script>
    document.querySelectorAll<HTMLElement>('[data-bg]').forEach((el) => {
      const card = el.closest('.group');
      if (!card) return;
      card.addEventListener('mouseenter', () => {
        if (!el.style.backgroundImage) {
          el.style.backgroundImage = `url(${el.dataset.bg})`;
        }
      }, { once: true });
    });
  </script>
)}
