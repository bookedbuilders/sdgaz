---
// Icon paths (Lucide stroke style): viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
const services = [
  { title: "Emergency Repairs",   img: "/assets/van.png",               iconPath: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>` },
  { title: "Electrical Panels",   img: "/assets/panels.jpg",            iconPath: `<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>` },
  { title: "Lighting Install",    img: "/assets/lighting.jpg",          iconPath: `<line x1="9" y1="18" x2="15" y2="18"/><line x1="10" y1="22" x2="14" y2="22"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/>` },
  { title: "Wiring & Rewiring",   img: "/assets/job4.png",              iconPath: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>` },
  { title: "EV Charging",         img: "/assets/ev-charger.jpg",        iconPath: `<path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/>` },
  { title: "Switches & Outlets",  img: "/assets/patio-service.jpg",     iconPath: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>` },
  { title: "Safety Inspections",  img: "/assets/ladder-service.jpg",    iconPath: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>` },
  { title: "Full Restoration",    img: "/assets/panel-electrician.jpg", iconPath: `<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>` },
];
---

<section id="services" class="pt-24 md:pt-32 bg-white text-black" aria-label="Services offered">
  <div class="max-w-7xl mx-auto px-6 md:px-12">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 md:mb-20 gap-8">
      <div class="max-w-2xl">
        <p class="text-accent font-black text-xs sm:text-sm uppercase tracking-[0.4em] mb-4 italic">Fast Solutions</p>
        <h2 class="text-5xl md:text-7xl lg:text-[72px] font-black uppercase italic tracking-tighter leading-[0.9]">FAST FIXES. <br />NO EXCUSES.</h2>
        <p class="mt-6 text-black/60 font-medium text-xl leading-relaxed">
          From flickering lights and dead outlets to full panel upgrades, we handle the 'small stuff' and the 'scary stuff' and get it done right.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {services.map((service) => (
        <div class="group relative bg-white p-6 md:p-10 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,0.05)] hover:bg-black hover:text-white transition-all duration-300 cursor-pointer flex flex-col items-center text-center overflow-hidden">
          <!-- Background image on hover — loaded via JS only on first hover to avoid 8 eager fetches -->
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-40 transition-opacity duration-500 bg-cover bg-center scale-110 group-hover:scale-100"
            data-bg={service.img}
          ></div>
          <div class="relative z-10 text-accent mb-4 md:mb-6 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={service.iconPath} />
          </div>
          <strong class="relative z-10 text-sm md:text-xl font-black uppercase italic tracking-tighter">{service.title}</strong>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Set background-image only on first hover — prevents 8 image fetches on page load
  document.querySelectorAll<HTMLElement>('[data-bg]').forEach((el) => {
    const card = el.closest('.group');
    if (!card) return;
    card.addEventListener('mouseenter', () => {
      if (!el.style.backgroundImage) {
        el.style.backgroundImage = `url(${el.dataset.bg})`;
      }
    }, { once: true });
  });
</script>
