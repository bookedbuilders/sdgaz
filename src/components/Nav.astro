---
interface Props {
  phoneNumber?: string;
}
const { phoneNumber = '480-415-0660' } = Astro.props;
const phoneHref = `tel:${phoneNumber}`;
---
<nav class="bg-white border-b-2 border-black px-6 md:px-12 py-4 flex items-center justify-between">
  <img src="/assets/logo.png" alt="SDG Electric Logo" class="h-10 md:h-14 w-auto object-contain" style="filter: url(#logo-stroke)" />
  <a
    href={phoneHref}
    class="flex items-center gap-2 bg-black text-white px-6 py-3 font-black text-sm uppercase italic tracking-widest border-2 border-black shadow-[6px_6px_0px_0px_#D58C46] hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="white" stroke="none" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.26 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.18 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    {phoneNumber}
  </a>
</nav>
