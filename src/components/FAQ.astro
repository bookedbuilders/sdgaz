---
interface Faq {
  q: string;
  a: string;
}

interface Props {
  faqs?: Faq[];
  eyebrow?: string;
}

const DEFAULT_FAQS: Faq[] = [
  {
    q: "Do you provide electrical services in Phoenix?",
    a: "Yes, we serve North Phoenix and the I-17 corridor from Anthem down to Central Phoenix — including New River, Cave Creek, Norterra, Deer Valley, Moon Valley, and Sunnyslope. Our licensed electricians are local and ready to help with same-day service availability in most neighborhoods.",
  },
  {
    q: "Do you offer financing for larger projects?",
    a: "Absolutely. We believe safety shouldn't wait for a payday. We offer flexible financing options for major upgrades like panel replacements, whole-home rewiring, or EV charger installations. You can apply quickly and get an immediate decision to help break your project into manageable monthly payments.",
  },
  {
    q: "Do you offer 24/7 emergency electrical repairs?",
    a: "Electrical failures don't follow a 9-to-5 schedule. If you're dealing with a total power loss, sparking outlets, or a burning smell, our emergency team is on standby. We provide rapid-response repairs around the clock to ensure your home remains safe and your family isn't left in the dark.",
  },
  {
    q: "Is my home's electrical system up to code?",
    a: "If your home is more than 20 years old or has undergone DIY renovations, it may not meet current NEC (National Electrical Code) standards. Outdated components like federal pacific panels or ungrounded outlets can be safety risks. We provide comprehensive safety inspections to identify code violations and keep your home compliant and insured.",
  },
];

const { faqs = DEFAULT_FAQS, eyebrow = 'The Facts' } = Astro.props;
---

<section id="faq" class="pt-24 pb-24 md:pt-32 md:pb-32 bg-white text-black" aria-label="Frequently asked questions">
  <div class="max-w-4xl mx-auto px-6 md:px-12">

    <div class="text-center mb-16 md:mb-24">
      <p class="text-accent font-black text-xs sm:text-sm uppercase tracking-[0.4em] mb-4 italic">{eyebrow}</p>
      <h2 class="text-5xl md:text-7xl lg:text-[72px] font-black italic tracking-tighter uppercase leading-[0.9]">COMMON <br />QUESTIONS</h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="bg-white border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] group open:shadow-none open:translate-x-[2px] open:translate-y-[2px] transition-all overflow-hidden">
          <summary class="w-full flex justify-between items-center p-6 sm:p-8 cursor-pointer list-none group-hover:bg-accent/5 transition-colors">
            <span class="font-black text-lg sm:text-xl md:text-2xl italic pr-8 uppercase tracking-tighter leading-tight">{faq.q}</span>
            <div class="p-3 sm:p-4 bg-black border-2 border-black shadow-[6px_6px_0px_0px_#D58C46] group-open:bg-accent group-open:shadow-none flex-shrink-0 transition-all duration-300">
              <svg class="group-open:hidden w-5 h-5 md:w-6 md:h-6 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <svg class="hidden group-open:block w-5 h-5 md:w-6 md:h-6 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
          </summary>
          <div class="p-6 sm:p-10 pt-0 text-black/70 normal-case font-medium leading-relaxed text-xl bg-white">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
