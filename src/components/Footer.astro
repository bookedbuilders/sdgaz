---
const PHONE_NUMBER = "602-905-5281";
---

<footer id="footer" class="bg-black text-white pt-24 pb-20 md:pt-32 border-t-[10px] border-accent relative overflow-hidden" style="content-visibility: auto; contain-intrinsic-size: auto 600px">
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="flex flex-col lg:flex-row justify-between items-start gap-16 md:gap-24 pb-16 md:pb-24 border-b-2 border-white/5 mb-16 md:mb-24 uppercase tracking-[0.2em] font-black italic">

      <!-- Brand -->
      <div class="space-y-10 md:space-y-12 flex-1">
        <div class="flex items-center gap-4">
          <img
            src="/assets/logo.png"
            alt="SDG Electric Logo"
            loading="lazy"
            decoding="async"
            class="h-16 md:h-24 w-auto object-contain"
            style="filter: url(#logo-stroke)"
          />
        </div>
        <p class="text-white/40 max-w-sm text-xl font-medium leading-relaxed normal-case">
          SDG Electric: Phoenix's Premium Choice for Power &amp; Safety. Always On. Always Local.
        </p>
        <div class="flex gap-4">
          {Array.from({length: 4}).map(() => (
            <div class="w-12 h-12 md:w-14 md:h-14 border-2 border-white/10 flex items-center justify-center hover:bg-accent hover:border-accent hover:text-black transition-all cursor-pointer group">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
          ))}
        </div>
      </div>

      <!-- Links -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-12 md:gap-20 flex-[2] text-sm">

        <div class="space-y-8 md:space-y-10">
          <p class="text-accent border-b-2 border-accent inline-block pb-1">CONNECT</p>
          <div class="space-y-4 md:space-y-6 font-black italic text-lg">
            <div class="flex items-start gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D58C46" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>35410 N 32ND DR, PHOENIX, AZ</span>
            </div>
            <div class="flex items-center gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D58C46" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.26 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.18 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <a href={`tel:${PHONE_NUMBER}`} class="hover:text-accent transition-colors">{PHONE_NUMBER}</a>
            </div>
          </div>
        </div>

        <div class="space-y-8 md:space-y-10">
          <p class="text-accent border-b-2 border-accent inline-block pb-1">LINKS</p>
          <ul class="space-y-4 md:space-y-6 text-xl">
            <li><a href="/#services"      class="hover:text-accent transition-colors">SERVICES</a></li>
            <li><a href="/#service-areas" class="hover:text-accent transition-colors">AREAS</a></li>
            <li><a href="/#faq"           class="hover:text-accent transition-colors">FAQ</a></li>
          </ul>
        </div>

        <div class="space-y-8 md:space-y-10">
          <p class="text-accent border-b-2 border-accent inline-block pb-1">TERRITORY</p>
          <ul class="space-y-3 md:space-y-4 text-white/50">
            <li>NORTH PHOENIX</li>
            <li>NORTH SCOTTSDALE</li>
            <li>PARADISE VALLEY</li>
            <li>CENTRAL PHOENIX</li>
            <li>WEST VALLEY</li>
          </ul>
        </div>

      </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center gap-8 md:gap-10 text-[10px] font-black uppercase tracking-[0.4em] md:tracking-[0.6em] italic text-white/10 mb-20 md:mb-0">
      <div class="flex flex-wrap justify-center gap-12">
        <a href="https://sdgaz.com/privacy-policy-2/" class="hover:text-accent transition-colors">PRIVACY</a>
        <a href="https://sdgaz.com/terms-and-conditions/" class="hover:text-accent transition-colors">TERMS</a>
      </div>
      <p>© 2026 SDG ELECTRIC</p>
    </div>
  </div>
</footer>
