---
interface Props {
  type: 'fire-hazard' | 'structural-defect' | 'inspection-fail';
  message: string;
}
const { type, message } = Astro.props;

const configs = {
  'fire-hazard':       { icon: '🔥', label: 'FIRE HAZARD',        bgClass: 'bg-red-600    border-red-800'    },
  'structural-defect': { icon: '⚡', label: 'STRUCTURAL DEFECT',   bgClass: 'bg-orange-500 border-orange-700' },
  'inspection-fail':   { icon: '⚠️', label: 'CLOSING NOTICE',      bgClass: 'bg-amber-500  border-amber-700'  },
};
const { icon, label, bgClass } = configs[type];
---
<div class={`${bgClass} border-b-4 text-white px-6 py-4`} role="alert">
  <div class="max-w-7xl mx-auto flex items-start sm:items-center gap-4">
    <span class="text-2xl shrink-0" aria-hidden="true">{icon}</span>
    <p class="font-medium text-sm leading-relaxed">
      <strong class="font-black uppercase tracking-widest text-xs mr-2 opacity-90">{label}:</strong>{message}
    </p>
  </div>
</div>
