---
const PHONE_NUMBER = "602-905-5281";
---

<section class="pt-24 pb-24 md:pt-32 md:pb-32 bg-white text-black" aria-label="Emergency service call to action">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="border-[6px] border-black flex flex-col lg:flex-row shadow-[12px_12px_0px_0px_#D58C46] md:shadow-[12px_12px_0px_0px_#D58C46] overflow-hidden">

      <!-- Copy -->
      <div class="p-8 sm:p-12 md:p-20 flex-1 flex flex-col justify-center bg-white order-2 lg:order-1">
        <p class="text-accent font-black text-xs sm:text-sm uppercase tracking-[0.4em] mb-4 italic">Emergency or Routine</p>
        <h2 class="text-5xl md:text-7xl lg:text-[72px] font-black text-black uppercase italic mb-8 md:mb-12 leading-[0.9] tracking-tighter">
          NEED <br /><span class="text-accent">POWER NOW?</span>
        </h2>
        <p class="text-xl font-medium text-black/70 leading-relaxed mb-12 max-w-2xl">
          Dispatching Licensed Electricians 24/7. <br class="hidden md:block" />Call or Book in 60 Seconds.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 w-full sm:w-auto">
          <a
            href="/book"
            aria-label="Book Now — emergency service"
            class="schedule-btn-rai w-full sm:w-auto flex items-center justify-center gap-3 bg-black text-white px-10 py-5 border-2 border-black shadow-[6px_6px_0px_0px_#D58C46] font-black text-sm uppercase italic tracking-widest hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all"
          >
            Schedule a Free Estimate
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#D58C46" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </a>
          <a
            href={`tel:${PHONE_NUMBER}`}
            aria-label="Call Now — emergency"
            class="w-full sm:w-auto flex items-center justify-center gap-3 bg-white text-black px-10 py-5 border-2 border-black shadow-[6px_6px_0px_0px_#D58C46] font-black text-sm uppercase italic tracking-widest hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="black" stroke="none"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.26 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.18 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call Now
          </a>
        </div>
      </div>

      <!-- Image -->
      <div class="flex-1 bg-black min-h-[400px] md:min-h-[500px] relative group order-1 lg:order-2 overflow-hidden">
        <img
          src="/assets/van-pink-wrap.jpg"
          alt="SDG Electric van"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover filter contrast-125 group-hover:scale-110 transition-transform duration-700"
        />
        <div class="absolute top-6 right-6 bg-accent text-white px-4 py-2 font-black italic uppercase text-[10px] tracking-widest">
          OUR PHOENIX FLEET
        </div>
      </div>

    </div>
  </div>
</section>
