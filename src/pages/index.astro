---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Fleet from '../components/Fleet.astro';
import CardGrid from '../components/CardGrid.astro';
import NeedPower from '../components/NeedPower.astro';
import Reviews from '../components/Reviews.astro';
import Comparison from '../components/Comparison.astro';
import Gallery from '../components/Gallery.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import Authority from '../components/Authority.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';

const services = [
  { title: "Emergency Repairs",   img: "/assets/van.png",               iconPath: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>` },
  { title: "Electrical Panels",   img: "/assets/panels.jpg",            iconPath: `<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>` },
  { title: "Lighting Install",    img: "/assets/lighting.jpg",          iconPath: `<line x1="9" y1="18" x2="15" y2="18"/><line x1="10" y1="22" x2="14" y2="22"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/>` },
  { title: "Wiring & Rewiring",   img: "/assets/job4.png",              iconPath: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>` },
  { title: "EV Charging",         img: "/assets/ev-charger.jpg",        iconPath: `<path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/>` },
  { title: "Switches & Outlets",  img: "/assets/patio-service.jpg",     iconPath: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>` },
  { title: "Safety Inspections",  img: "/assets/ladder-service.jpg",    iconPath: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>` },
  { title: "Full Restoration",    img: "/assets/panel-electrician.jpg", iconPath: `<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>` },
];
---

<Base>
  <div class="min-h-screen bg-white font-sans text-black overflow-x-hidden w-full relative">
    <Hero />
    <TrustBar />
    <Fleet />
    <CardGrid
      cards={services}
      variant="services"
      eyebrow="Fast Solutions"
      headline='FAST FIXES. <br />NO EXCUSES.'
      subheadline="From flickering lights and dead outlets to full panel upgrades, we handle the 'small stuff' and the 'scary stuff' and get it done right."
      sectionId="services"
      sectionLabel="Services offered"
      padBottom={false}
    />
    <NeedPower />
    <Reviews />
    <Comparison />
    <Gallery />
    <ServiceAreas />
    <Authority />
    <FAQ />
    <Footer />
    <MobileStickyCTA />
  </div>
</Base>
