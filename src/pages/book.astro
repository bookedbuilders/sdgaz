---
import Base from '../layouts/Base.astro';
import { SURVEY_URL } from '../config';

const PHONE_NUMBER = "480-536-9456";
---

<Base
  title="Schedule a Free Estimate | SDG Electric"
  description="Book a free electrical estimate with SDG Electric in Phoenix, AZ. Licensed, insured, and available 24/7."
  noindex={true}
>
  <main class="min-h-dvh bg-white font-sans text-black flex flex-col">
    <header class="flex items-center justify-between gap-4 px-5 sm:px-10 py-4 border-b-2 border-black">
      <a href="/" aria-label="SDG Electric home">
        <img src="/assets/logo.png" alt="SDG Electric" width="120" height="40" class="h-8 w-auto" />
      </a>
      <a
        href={`tel:${PHONE_NUMBER}`}
        class="font-black uppercase text-xs tracking-widest border-2 border-black px-5 py-3 hover:bg-black hover:text-white transition-all"
      >
        Call {PHONE_NUMBER}
      </a>
    </header>

    <iframe
      id="booking-frame"
      data-src={SURVEY_URL}
      title="Schedule a free estimate"
      class="w-full flex-1 border-none"
    ></iframe>
    <script is:inline>
      (function () {
        var f = document.getElementById('booking-frame');
        var base = f.dataset.src;
        f.src = window.__sdgSurveyUrl ? window.__sdgSurveyUrl(base) : base;
      })();
    </script>

    <footer class="flex items-center justify-between gap-4 px-5 sm:px-10 py-3 border-t-2 border-black text-[10px] font-black uppercase italic tracking-widest">
      <div class="flex gap-6">
        <a href="https://sdgaz.com/privacy-policy-2/" target="_blank" rel="noopener" class="text-black/40 hover:text-accent transition-colors">Privacy</a>
        <a href="https://sdgaz.com/terms-and-conditions/" target="_blank" rel="noopener" class="text-black/40 hover:text-accent transition-colors">Terms</a>
      </div>
      <p class="text-black/30">© 2026 SDG Electric</p>
    </footer>
  </main>
</Base>
